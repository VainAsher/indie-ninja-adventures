  "visual_effects": {
    "brightness_overlay": {
      "description": "Dark overlay that dims the hub based on brightness value",
      "blend_mode": "multiply",
      "color": [0, 0, 0],
      "alpha_calculation": "1.0 - brightness"
    },

    "portal_dimming": {
      "description": "Portals dim and color-shift based on hub atmosphere",
      "vibrant": {
        "glow_intensity": 1.0,
        "color_shift": [1.0, 1.0, 1.0]
      },
      "dimming": {
        "glow_intensity": 0.7,
        "color_shift": [0.9, 0.9, 1.0]
      },
      "dark": {
        "glow_intensity": 0.3,
        "color_shift": [0.7, 0.7, 0.9]
      },
      "recovering": {
        "glow_intensity": 0.5,
        "color_shift": [0.8, 0.9, 1.0]
      },
      "restored": {
        "glow_intensity": 0.95,
        "color_shift": [1.0, 1.0, 1.0]
      },
      "bittersweet": {
        "glow_intensity": 1.0,
        "color_shift": [1.0, 0.95, 0.9]
      }
    },

    "constellation_yin_yang": {
      "description": "Yin and Yang appear as constellation in sky (postgame)",
      "position": [640, 100],
      "star_count": 8,
      "yin_color": [220, 220, 255],
      "yang_color": [255, 220, 150],
      "twinkle_speed": 2.0,
      "alpha_range": [0.7, 1.0]
    }
  },

