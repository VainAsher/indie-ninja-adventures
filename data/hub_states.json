          "brightness": 1.0,
          "atmosphere": "vibrant",
          "npcs_active": ["elder", "shopkeeper_weapons", "shopkeeper_armor", "townsperson_1", "townsperson_2", "townsperson_3", "townsperson_4", "townsperson_5", "guard_1", "guard_2", "merchant_1", "merchant_2", "blacksmith"]
