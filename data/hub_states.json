        "5": {
          "brightness": 0.7,
          "npcs_active": ["lantern_1_keeper", "lantern_2_listener", "lantern_3_guide", "lantern_4_warrior", "lantern_5_elder"],
          "comment": "Fifth Lantern: The Elder (wisdom)"
