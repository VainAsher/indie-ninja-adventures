{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "npc_def_schema.json",
  "type": "object",
  "required": ["id", "displayName", "width", "height", "animationKey"],
  "additionalProperties": false,
  "properties": {
    "$schema":          { "type": "string" },
    "id":               { "type": "string", "minLength": 1 },
    "displayName":      { "type": "string" },
    "width":            { "type": "integer", "minimum": 1 },
    "height":           { "type": "integer", "minimum": 1 },
    "animationKey":     { "type": "string" },
    "dialogueTreeId":   { "type": "string" },
    "isQuestGiver":     { "type": "boolean" },
    "isShop":           { "type": "boolean" },
    "isBoss":           { "type": "boolean" },
    "bossPhases":       { "type": "integer", "minimum": 1 },
    "bossAnimationKeys":{ "type": "array", "items": { "type": "string" } },
    "hubPresenceByState": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  }
}
